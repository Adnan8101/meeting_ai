{
  "version": 2,
  "buildCommand": "python vercel_build.py",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/check_username",
      "destination": "/api/index.py"
    },
    {
      "source": "/register",
      "destination": "/api/index.py"
    },
    {
      "source": "/login",
      "destination": "/api/index.py"
    },
    {
      "source": "/forget-password",
      "destination": "/api/index.py"
    },
    {
      "source": "/verify_email/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/verify_reset_code",
      "destination": "/api/index.py"
    },
    {
      "source": "/verify_reset_code/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/trello/connect",
      "destination": "/api/index.py"
    },
    {
      "source": "/trello/save_token",
      "destination": "/api/index.py"
    },
    {
      "source": "/jira/connect",
      "destination": "/api/index.py"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
