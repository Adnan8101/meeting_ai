{
  "version": 2,
  "buildCommand": "python vercel_build.py",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/check_username",
      "destination": "/api/index.py"
    },
    {
      "source": "/register",
      "destination": "/api/index.py"
    },
    {
      "source": "/login",
      "destination": "/api/index.py"
    },
    {
      "source": "/logout",
      "destination": "/api/index.py"
    },
    {
      "source": "/forget-password",
      "destination": "/api/index.py"
    },
    {
      "source": "/forgot-password",
      "destination": "/api/index.py"
    },
    {
      "source": "/forgot_password",
      "destination": "/api/index.py"
    },
    {
      "source": "/verify_email/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/verify_reset_code",
      "destination": "/api/index.py"
    },
    {
      "source": "/verify_reset_code/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/resend_verification/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/trello/connect",
      "destination": "/api/index.py"
    },
    {
      "source": "/trello/save_token",
      "destination": "/api/index.py"
    },
    {
      "source": "/trello/disconnect",
      "destination": "/api/index.py"
    },
    {
      "source": "/jira/connect",
      "destination": "/api/index.py"
    },
    {
      "source": "/jira/disconnect",
      "destination": "/api/index.py"
    },
    {
      "source": "/assistant/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/get_lists/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/get_jira_projects",
      "destination": "/api/index.py"
    },
    {
      "source": "/get_jira_issue_types/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/slack/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/analyse",
      "destination": "/api/index.py"
    },
    {
      "source": "/analyze",
      "destination": "/api/index.py"
    },
    {
      "source": "/home",
      "destination": "/api/index.py"
    },
    {
      "source": "/dashboard",
      "destination": "/api/index.py"
    },
    {
      "source": "/team",
      "destination": "/api/index.py"
    },
    {
      "source": "/create_team",
      "destination": "/api/index.py"
    },
    {
      "source": "/invite",
      "destination": "/api/index.py"
    },
    {
      "source": "/integrations",
      "destination": "/api/index.py"
    },
    {
      "source": "/ai-chat",
      "destination": "/api/index.py"
    },
    {
      "source": "/_debug/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
